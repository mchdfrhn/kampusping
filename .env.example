# Optional overrides for `docker compose up`. Copy to `.env`; every value has a default.
# Never commit the real file.

POSTGRES_PASSWORD=postgres
SECRET_KEY=change-me-development-only-secret-key-0000000000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-12345

# Host ports (change them when 3000/8000 are already in use).
WEB_PORT=3000
API_PORT=8000

APP_NAME=KampusPing
PRIMARY_COLOR=#0F766E

# --- Scheduling (api and worker) ----------------------------------------------------------------
# IANA zone for the sending window and "today"; the worker checks for due messages this often.
APP_TIMEZONE=Asia/Jakarta
WORKER_TICK_SECONDS=60

# --- WhatsApp -----------------------------------------------------------------------------------
# fake = messages are only recorded in memory (default). gateway = the real WhatsApp gateway; then
# start the stack with:  docker compose --profile whatsapp up --build
WA_PROVIDER=fake

# Shared secrets between the api/worker and the gateway. Both are needed only with WA_PROVIDER=gateway.
# The values below are DEV PLACEHOLDERS and the gateway REFUSES them ("change-me..." or shorter than
# 16 characters): replace both with random values, e.g. `openssl rand -hex 32`. Never commit the
# real .env.
WA_GATEWAY_API_KEY=change-me-to-a-long-random-key
WA_WEBHOOK_SECRET=change-me-to-another-long-random-secret
