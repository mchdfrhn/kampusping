# Optional overrides for `docker compose up`. Copy to `.env`; every value has a default.
# Never commit the real file.

POSTGRES_PASSWORD=postgres
SECRET_KEY=change-me-development-only-secret-key-0000000000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-12345

# Host ports (change them when 3000/8000 are already in use).
WEB_PORT=3000
API_PORT=8000

APP_NAME=Webapp
PRIMARY_COLOR=#4F46E5
